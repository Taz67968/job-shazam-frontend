generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://cliff:Tazoh2005@localhost:5432/jobShazam"
}

model TrackedJob {
  id             String   @id @default(uuid())
  title          String
  company        String
  location       String
  url String
  type       String
  appliedDate   DateTime @default(now())
  status         String
  createdAt      DateTime @default(now())

  @@unique([title, company, location, url])
}
